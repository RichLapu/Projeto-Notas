{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.6.2"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "public/build"
            }
        }
    ],
    "routes": [
        {
            "src": "/build/(.*\\.js)",
            "dest": "/public/build/$1",
            "headers": { "content-type": "application/javascript" }
        },
        {
            "src": "/build/(.*\\.css)",
            "dest": "/public/build/$1",
            "headers": { "content-type": "text/css" }
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/assets/(.*\\.png)",
            "dest": "/public/assets/$1",
            "headers": { "content-type": "image/png" }
        },
        {
            "src": "/assets/(.*)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico",
            "headers": { "content-type": "image/x-icon" }
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}